# --- Base de datos ---
# Desarrollo local (rápido, sin servidor): SQLite
DATABASE_URL="file:./dev.db"

# Producción (recomendado): PostgreSQL — Railway, Render, Neon, Supabase
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Si usas PostgreSQL, cambia el `provider` en prisma/schema.prisma a "postgresql".

# --- Seguridad de sesión ---
# Cadena larga y aleatoria. Genera una con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Almacenamiento de archivos ---
# MVP: los archivos se guardan en ./uploads (privado).
# Producción: integra Cloudinary o AWS S3 (ver README).
UPLOAD_DIR="./uploads"
