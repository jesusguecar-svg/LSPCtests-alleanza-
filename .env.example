# --- Base de datos ---
# Desarrollo local (rápido, sin servidor): SQLite
DATABASE_URL="file:./dev.db"

# Producción (recomendado): PostgreSQL — Railway, Render, Neon, Supabase
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Si usas PostgreSQL, cambia el `provider` en prisma/schema.prisma a "postgresql".

# --- Seguridad de sesión ---
# Cadena larga y aleatoria. Genera una con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Almacenamiento de archivos ---
# Sin Cloudinary: los archivos se guardan en ./uploads (privado, solo desarrollo local).
# Con Cloudinary (recomendado para producción): sube a https://cloudinary.com
# Ver README para instrucciones de configuración.
UPLOAD_DIR="./uploads"

# --- Cloudinary (OPCIONAL) —
# Si dejas vacío, la app usa almacenamiento local (./uploads).
# Para producción, configura Cloudinary:
# 1) Crea una cuenta gratis en https://cloudinary.com
# 2) Copia tu Cloud Name, API Key y genera un Upload Preset (sin autenticación)
# 3) Pega los valores aquí
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_UPLOAD_PRESET=""

# --- Correo (Resend) — OPCIONAL ---
# Si se deja vacío, la app funciona igual con notificaciones in-app (sin email).
# 1) Crea una cuenta gratis en https://resend.com y copia tu API key (re_...).
# 2) Para enviar desde tu dominio, verifícalo en Resend y usa una dirección tuya
#    en EMAIL_FROM. Sin dominio verificado, usa el remitente de pruebas.
RESEND_API_KEY=""
EMAIL_FROM="Onboarding <onboarding@resend.dev>"
# URL pública de la app, usada en los botones de los correos (sin barra final).
APP_URL="http://localhost:3000"
